  "dependencies": {
    "@elog/cli": "1.0.0-beta.5",
    "@elog/plugin-sdk": "1.0.0-beta.2",
    "@elog/plugin-to-local": "1.0.0-beta.5",
    "@elog/plugin-transform-image-local": "1.0.0-beta.5",
    "@elog/plugin-from-yuque-pwd": "1.0.0-beta.5",
    "@astrojs/mdx": "6.0.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "6.4.8",
    "dayjs": "1.11.23",
    "lodash.kebabcase": "4.1.1",
    "rehype-callouts": "2.2.0",
    "remark-collapse": "0.1.2",
    "remark-toc": "9.0.0",
    "slugify": "1.6.9",
