{
  "name": "yuque-astro",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync": "elog sync -c elog.config.ts",
    "sync:local": "elog sync -c elog.config.ts -e .env",
